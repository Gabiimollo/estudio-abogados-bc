        "html": "=<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#1a1a1a\">\n  <h2 style=\"color:#C9A040;margin:0 0 16px\">Nueva consulta desde la web</h2>\n  <table cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse:collapse\">\n    <tr><td><b>Nombre</b></td><td>{{ $json.nombre }} {{ $json.apellido }}</td></tr>\n    <tr><td><b>Email</b></td><td><a href=\"mailto:{{ $json.email }}\">{{ $json.email }}</a></td></tr>\n    <tr><td><b>Teléfono</b></td><td>{{ $json.telefono }}</td></tr>\n    <tr><td><b>Tipo de consulta</b></td><td>{{ $json.tipoConsulta }}</td></tr>\n    <tr><td><b>Consentimiento</b></td><td>{{ $json.consentimiento }}</td></tr>\n    <tr><td><b>Fecha</b></td><td>{{ $json.fechaLocal }} hs</td></tr>\n  </table>\n  <h3 style=\"margin:20px 0 6px\">Mensaje</h3>\n  <div style=\"white-space:pre-wrap;border-left:3px solid #C9A040;padding-left:12px\">{{ $json.mensaje }}</div>\n  <p style=\"margin-top:20px;color:#666;font-size:12px\">Respondé directamente a este mail para contactar al consultante.</p>\n</div>",
